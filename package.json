{
  "name": "technologist-academy-node-service-template",
  "version": "1.0.0",
  "description": "A template repository for node services developed in the Technologist Academy",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "postinstall": "prisma generate && (prisma skills sync || exit 0)"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "prisma": "^7.10.1",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
