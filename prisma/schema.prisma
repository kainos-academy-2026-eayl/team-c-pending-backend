generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        Int    @id @default(autoincrement())
  email     String @unique
  password  String
  firstName String
  lastName  String
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  description String
  category    String
  quantity    Int
  image       String?
}
